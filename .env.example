# Kan env template for May First (ops).
# Names match upstream kanbn/kan .env.example — do not invent aliases.
# Copy to server `.env` only. Never commit real secrets.
# Upstream pin: see KAN_VERSION (v0.6.0). All Kan GitHub Releases are
# currently marked prerelease; we pin latest published tag intentionally.
#
# Runtime-only public URL(s): the GitHub Release tarball is site-agnostic.
# NEXT_PUBLIC_BASE_URL (and NEXT_PUBLIC_STORAGE_* when used) MUST be set here on
# the server — they are NOT embedded in the Build release artifact. Kan reads
# them at process start via next-runtime-env / bootstrap.cjs → public/__ENV.js.
# NOLA example values below; CC uses https://kan.cooperativecodebase.com (+ S3).

# --- Required ---
NEXT_PUBLIC_BASE_URL=https://kan.dsaneworleans.org
# Generate: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32
BETTER_AUTH_SECRET=

# May First Postgres connection string from control panel
POSTGRES_URL=

# Compose-only upstream var — unused on May First (leave blank)
POSTGRES_PASSWORD=

# Runtime listen (used by scripts/start.sh; Apache ProxyPass must match PORT)
HOSTNAME=127.0.0.1
PORT=

# --- Auth (email-invite-only MVP / chapter option 2a) ---
NEXT_PUBLIC_ALLOW_CREDENTIALS=true
# true = only emails with a pending Members invite can register (shipping).
# false = required if you later enable workspace invite-link self-signup (2b);
#          then anyone who discovers /signup can register. See docs/access-model.md.
NEXT_PUBLIC_DISABLE_SIGN_UP=true

# --- SMTP (Proton; reuse an existing chapter automation mailbox) ---
SMTP_HOST=smtp.protonmail.ch
# Use 587 + SMTP_SECURE=false (Proton submission). Upstream default example is 465.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Prefer a display name, e.g. NOLA DSA Kan <your-mailbox@example.com>
EMAIL_FROM=
SMTP_SECURE=false
# SMTP_REJECT_UNAUTHORIZED=

# Leave unset to keep email features on
# NEXT_PUBLIC_DISABLE_EMAIL=

# --- S3 / uploads (SeaweedFS at s3.dsaneworleans.org — see docs/s3-seaweedfs-checklist.md) ---
# Leave unset until Seaweed + Apache are live; then set on the Kan server .env only.
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.dsaneworleans.org
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# NEXT_PUBLIC_STORAGE_URL=https://s3.dsaneworleans.org
# NEXT_PUBLIC_AVATAR_BUCKET_NAME=avatars
# NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=attachments
# NEXT_PUBLIC_STORAGE_DOMAIN=s3.dsaneworleans.org
# NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=

# --- Out of MVP: Redis (in-memory rate limit is OK) ---
# REDIS_URL=

# --- Out of MVP: OAuth ---
# BETTER_AUTH_TRUSTED_ORIGINS=
# BETTER_AUTH_ALLOWED_DOMAINS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- Optional ---
# NEXT_API_BODY_SIZE_LIMIT=
# LOG_LEVEL=info
# TRELLO_APP_API_KEY=
# TRELLO_APP_SECRET=
